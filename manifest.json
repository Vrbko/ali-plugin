{
  "manifest_version": 3,
  "name": "Bundle Deal Filter",
  "version": "1.0",
  "description": "Hides products labeled as Bundle Deals on AliExpress.",
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["*://*.aliexpress.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "192": "icon.png"
  }
}